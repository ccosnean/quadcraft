# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Store submission pipeline (see store/README.md).
# store/ itself is the source of truth and stays tracked; everything below
# is generated by tool/store/sync_store_content.dart or capture_screenshots.sh,
# or is a real credential file.
/ios/fastlane/metadata/
/ios/fastlane/screenshots/
/ios/fastlane/.env
/ios/fastlane/*.p8
/android/fastlane/metadata/
/android/fastlane/.env
/android/fastlane/*play-store-credentials*.json
/store/screenshots/**/*.png
