default_platform(:ios)

require "yaml"

# store/app.yaml is the source of truth for non-localized submission answers
# (see store/README.md). Content itself (ios/fastlane/metadata,
# ios/fastlane/screenshots) is regenerated by
# `dart run tool/store/sync_store_content.dart` — run tool/store/publish.sh
# rather than these lanes directly so that step never gets skipped.
STORE_CONFIG = YAML.load_file(File.expand_path("../../store/app.yaml", __dir__))
IOS_CONFIG = STORE_CONFIG["ios"]

before_all do
  app_store_connect_api_key(
    key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
    issuer_id: ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
    key_filepath: ENV["APP_STORE_CONNECT_API_KEY_PATH"]
  )
end

platform :ios do
  desc "Upload metadata (name, description, keywords, etc.) — no binary, no screenshots"
  lane :metadata do
    deliver(
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_app_version_update: true,
      force: true,
      submission_information: submission_info
    )
  end

  desc "Upload screenshots only"
  lane :screenshots do
    deliver(
      skip_binary_upload: true,
      skip_metadata: true,
      overwrite_screenshots: true,
      force: true
    )
  end

  desc "Upload metadata and screenshots together — no binary"
  lane :metadata_and_screenshots do
    deliver(
      skip_binary_upload: true,
      overwrite_screenshots: true,
      force: true,
      submission_information: submission_info
    )
  end

  # Export compliance / content rights / IDFA — the flat-boolean part of
  # Apple's submission questionnaire, stable enough to script. The age
  # rating matrix and App Privacy "nutrition label" are not: fill those in
  # App Store Connect by hand once (store/app.yaml's ios.age_rating block
  # is the drafted answer key to transcribe), see store/README.md.
  def submission_info
    {
      export_compliance_uses_encryption: IOS_CONFIG["uses_encryption"],
      content_rights_contains_third_party_content: IOS_CONFIG["contains_third_party_content"],
      add_id_info_uses_idfa: IOS_CONFIG["uses_idfa"]
    }
  end
end
