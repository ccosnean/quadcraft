# Copy this file to android/fastlane/.env (gitignored) and fill in the real
# path. fastlane loads .env automatically — no extra config needed.
#
# Google Play service account JSON key: Play Console > Setup > API access,
# via a Google Cloud service account. See store/README.md step 2 for exact
# navigation.
SUPPLY_JSON_KEY=./play-store-credentials.json
