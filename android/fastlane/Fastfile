default_platform(:android)

# android/fastlane/metadata is regenerated by
# `dart run tool/store/sync_store_content.dart` — run tool/store/publish.sh
# rather than these lanes directly so that step never gets skipped.
#
# supply needs a build already on the track to attach metadata-only updates
# to (Play Console requires this for a brand-new app anyway — see
# store/README.md step 3), so these lanes never touch the binary.

platform :android do
  desc "Upload metadata (title, descriptions, changelog) — no binary, no screenshots"
  lane :metadata do
    supply(
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Upload screenshots only"
  lane :screenshots do
    supply(
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: false
    )
  end

  desc "Upload metadata and screenshots together — no binary"
  lane :metadata_and_screenshots do
    supply(
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_images: true
    )
  end
end
